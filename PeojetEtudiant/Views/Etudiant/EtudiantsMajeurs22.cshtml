@model IEnumerable<PeojetEtudiant.Models.Etudiants>

@{
    ViewData["Title"] = "Étudiants majeurs (âge > 22)";
}

<div class="container mt-5">
    <div class="row">
        <div class="col">
            <h1 class="mb-4 text-center">@ViewData["Title"]</h1>

            <table class="table table-bordered table-hover table-striped shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Nom</th>
                        <th>Âge</th>
                        <th>Classe</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Nom)</td>
                            <td>@Html.DisplayFor(modelItem => item.Age)</td>
                            <td>@Html.DisplayFor(modelItem => item.Classe.labelle)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="text-start mt-4">
                <a asp-action="Index" class="btn btn-secondary btn-lg shadow-sm">
                    ← Retour à la liste complète
                </a>
            </div>
        </div>
    </div>
</div>
